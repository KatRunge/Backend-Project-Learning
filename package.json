{
  "name": "backend-project-learning",
  "version": "1.0.0",
  "description": "A simple Express.js server",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "generate:openapi": "node generate-openapi-spec.js",
    "generate:client": "openapi-generator-cli generate -i spec.json -g typescript-axios -o ./generated-client --additional-properties=npmName=@myapp/api-client,supportsES6=true,withSeparateModelsAndApi=true,apiPackage=services,modelPackage=types"
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.25.0",
    "nodemon": "^3.0.2"
  }
}
